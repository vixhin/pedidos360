# ==============================================================================
# Pedidos360 Runtime Production Environment Configuration
# ==============================================================================
# Copie este archivo a .env.production y complete con los valores reales.
# NUNCA guarde secretos en el repositorio ni en archivos de Terraform.
# ==============================================================================

# Dominio y URL pública de la aplicación
PUBLIC_DOMAIN=pedidos360.cl
PUBLIC_URL=https://pedidos360.cl
FRONTEND_ORIGIN=https://pedidos360.cl

# Base de Datos PostgreSQL (Contenedor interno o RDS)
POSTGRES_USER=pedidos360_admin
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_PROD_ROBUSTO_AQUI
DB_USER=pedidos360_admin
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_PROD_ROBUSTO_AQUI

# Broker de Mensajería RabbitMQ
RABBITMQ_USER=pedidos360_rabbit_admin
RABBITMQ_PASSWORD=CAMBIAR_PASSWORD_RABBIT_PROD_ROBUSTO_AQUI

# Claves Secretas y Seguridad
BFF_INTERNAL_KEY=CAMBIAR_BFF_INTERNAL_KEY_PROD_MINIMO_32_CARACTERES
JWT_SECRET=CAMBIAR_JWT_SECRET_PROD_AQUI_MINIMO_32_CARACTERES
ADMIN_BOOTSTRAP_TOKEN=CAMBIAR_ADMIN_BOOTSTRAP_TOKEN_PROD_ROBUSTO

# Cloudflare Turnstile Producción
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=CAMBIAR_TURNSTILE_SITE_KEY_PRODUCCION
TURNSTILE_SECRET_KEY=CAMBIAR_TURNSTILE_SECRET_KEY_PRODUCCION

# Autenticación Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=CAMBIAR_AZURE_TENANT_ID_PRODUCCION
AZURE_API_CLIENT_ID=CAMBIAR_AZURE_API_CLIENT_ID_PRODUCCION

# Configuración de Chat
CHAT_RETENTION_DAYS=30
