# ==============================================================================
# Pedidos360 Runtime Production Environment Configuration
# ==============================================================================
# Copie este archivo a .env.production y complete con los valores reales.
# NUNCA guarde secretos en el repositorio ni en archivos de Terraform.
# ==============================================================================

# Dominio y URL pública de la aplicación (generados con la Elastic IP y sslip.io)
PUBLIC_DOMAIN=3-92-44-37.sslip.io
PUBLIC_URL=https://3-92-44-37.sslip.io
FRONTEND_ORIGIN=https://3-92-44-37.sslip.io

# Base de Datos PostgreSQL (Contenedor interno)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_PROD_AQUI

# Broker de Mensajería RabbitMQ (Contenedor interno)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CAMBIAR_PASSWORD_RABBIT_PROD_AQUI

# Claves Secretas y Seguridad
BFF_INTERNAL_KEY=pedidos360-internal-secret-key-prod-2026
JWT_SECRET=CAMBIAR_JWT_SECRET_PROD_AQUI_MINIMO_32_CARACTERES

# Autenticación Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=a50f6528-499a-4d94-bcad-ed9b200f7c7b
AZURE_API_CLIENT_ID=5febc8e2-ee14-4452-8914-7d237eb5a6f5

# Configuración de Chat
CHAT_RETENTION_DAYS=30
