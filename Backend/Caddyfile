# Caddyfile — HTTPS automático (Let's Encrypt) + proxy reverso.
# PUBLIC_DOMAIN se pasa como variable de entorno, ej: 34-207-191-208.nip.io

{$PUBLIC_DOMAIN} {
    encode gzip

    # BFF (API Manager) — valida JWT de Microsoft Entra ID
    handle /api/bff/* {
        reverse_proxy bff:8090
    }

    # Login/registro de cuenta BD y auth interno
    handle /api/auth/* {
        reverse_proxy usuario:8081
    }
    handle /api/usuario/* {
        reverse_proxy usuario:8081
    }

    # Microservicios directos (compatibilidad con login de cuenta BD)
    handle /api/productos/* {
        reverse_proxy productos:8085
    }
    handle /api/pedidos/* {
        reverse_proxy pedidos:8082
    }
    handle /api/carrito/* {
        reverse_proxy carrito:8083
    }
    handle /api/notificacion/* {
        reverse_proxy notificacion:8086
    }
    handle /api/analitica/* {
        reverse_proxy analitica:8084
    }

    # Todo lo demás: el frontend (Angular servido por nginx)
    handle {
        reverse_proxy frontend:80
    }
}
