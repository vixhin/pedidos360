<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Misma versión que los demás microservicios del proyecto -->
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>cl.duoc.pedidos360</groupId>
  <artifactId>bff</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>bff</name>
  <description>Backend for Frontend (BFF) — Pedidos360. Valida JWT de Microsoft Entra ID y actúa como proxy hacia los microservicios internos.</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>

    <!-- ─── WEB (Spring MVC) ──────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ─── SEGURIDAD + OAUTH2 RESOURCE SERVER ───── -->
    <!--
      Habilita:
        - spring.security.oauth2.resourceserver.jwt.*
        - JwtDecoder con JWKS automático desde Microsoft
        - Validación de firma, issuer y exp de forma automática
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- ─── WEBCLIENT (proxy a microservicios) ─────── -->
    <!--
      spring-boot-starter-webflux incluye WebClient.
      Se usa de forma reactiva pero de manera no-bloqueante.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- ─── JACKSON (JSON serialization) ─────────────── -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- ─── ACTUATOR (health, ready) ──────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ─── TESTS ─────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Reactor test para WebTestClient -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
