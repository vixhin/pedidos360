# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: PRODUCCIÓN (PROD)
# ==============================================================================
# IMPORTANTE: No subir este archivo con secretos reales a repositorios públicos.
# Copiar este archivo como .env dentro del servidor EC2 o inyectar en Docker Compose.

SPRING_PROFILES_ACTIVE=prod

# ─── Clave Interna de Comunicación Inter-Servicios ─────────────────────────────
# Generar una clave segura aleatoria en producción
BFF_INTERNAL_KEY=CAMBIAR_POR_CLAVE_SECRETA_PRODUCCION_LUNGS360_2026

# ─── Frontend (CORS) ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://pedidos360.duoc.cl

# ─── Microsoft Entra ID (Azure AD Production App Registration) ───────────────
AZURE_TENANT_ID=TU_AZURE_TENANT_ID_PROD
AZURE_API_CLIENT_ID=TU_AZURE_CLIENT_ID_PROD

# ─── Base de Datos PostgreSQL Producción ──────────────────────────────────────
DB_HOST=postgres-prod-host
DB_PORT=5432
DB_USER=pedidos360_user
DB_PASSWORD=TU_PASSWORD_SUPER_SEGURO_PROD

# ─── RabbitMQ Producción ──────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq-prod-host
RABBITMQ_PORT=5672
RABBITMQ_USER=admin_prod
RABBITMQ_PASSWORD=TU_RABBITMQ_PASSWORD_PROD
RABBITMQ_AUTO_STARTUP=true

# ─── URLs de Microservicios para BFF (Red interna Docker / AWS Service Connect) ───
USUARIO_SERVICE_URL=http://usuario:8081
PEDIDOS_SERVICE_URL=http://pedidos:8082
CARRITO_SERVICE_URL=http://carrito:8083
ANALITICA_SERVICE_URL=http://analitica:8084
PRODUCTOS_SERVICE_URL=http://productos:8085
NOTIFICACION_SERVICE_URL=http://notificacion:8086
