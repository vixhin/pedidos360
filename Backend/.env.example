# Configuración de Entorno Backend Pedidos360 (Desarrollo Local)
# Copia este archivo a .env y asigna valores reales por cada entorno.

BFF_INTERNAL_KEY=pedidos360-internal-secret-key-local-2026
JWT_SECRET=pedidos360_dev_secret_key_for_jwt_token_generation_local_environment_2026
ADMIN_BOOTSTRAP_TOKEN=dev-admin-bootstrap-token-2026
FRONTEND_ORIGIN=http://localhost:4200
AZURE_TENANT_ID=a50f6528-499a-4d94-bcad-ed9b200f7c7b
AZURE_API_CLIENT_ID=5febc8e2-ee14-4452-8914-7d237eb5a6f5

# Cloudflare Turnstile (Claves oficiales de prueba de Cloudflare)
# Sitekey Always Passes: 1x00000000000000000000AA
# Secret Key Always Passes: 1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Configuración RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Configuración PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
